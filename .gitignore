# Dependencies
node_modules/

# Electron build output
dist/
out/

# Engine binaries and embedded Python (huge, gitignored)
engine/
llama_engine/
llama_models/
.engine-config.json

# User data
# Dev-fallback external-project registry — holds machine-local paths; the durable
# copy lives in <Documents>/Cubric Vision/. Never track (see routes/shared.js).
project-paths.json
resources/*
!resources/enhancer_prompts.md
!resources/cubric/
!resources/cubric/connector-manifest.json

# Contains a hardcoded HF token — keep local only, do not track
comfy_workflows/scripts/upload-models/upload.py

# User's personal ComfyUI tool — not used by the app, never committed (both the
# raw LiteGraph source and any converted copy)
comfy_workflows/Model Merger.json
comfy_workflows/raw/Model Merger.json

# Worktrees
.worktrees/

# agents
.agent
# Kanban private scratch — contents NEVER committed, README kept so a fresh
# clone still explains the convention. See .claude/rules/kanban.md.
.agents/mpi-kanban/private/*
!.agents/mpi-kanban/private/README.md
.claude/settings.local.json
.claude/playwright-cli
.claude/skills/mpi-component-audit/.last-audit.json
.playwright
.playwright-cli
playwright-report/
test-results/
docs/superpowers/
.kilo

# Temporary files
media-for-testing/
tmp/
*.tmp
*.log
# `*.log` misses rotation targets (app.log.1 — extension is `.1`). Ignore the
# whole logs dir so numbered rotations and any future sink are covered. (MPI-315)
logs/

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini
project-paths.json

# Editor
.vscode
*.code-workspace

# Secrets / local config (if any added later)
.env
.env.local
.expose-comfy

# impeccable skill scratch output
.impeccable/

# Python bytecode — repo scripts and kanban card scripts are run in place
__pycache__/
*.pyc

# Mpi-Kanban runtime state - sessions, file claims, messages, handoffs, hook flags.
# Machine-local coordination the hooks read off DISK (guard-claim resolves owner_session
# by path; live_peers scans sessions/ for a fresh heartbeat). Git plays no part, and a
# record arriving by pull is stale by definition - a heartbeat older than the push is
# past heartbeat_timeout_minutes. The BOARD stays tracked: board.json, tasks/ and
# tasks/_archived/ (the only copy of an archived card). See .claude/rules/kanban.md.
.agents/mpi-kanban/state/
